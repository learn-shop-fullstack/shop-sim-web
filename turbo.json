{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // 어떤 패키지에도 없는 스크립트 이름이라 실행되는 것은 없다. 의존 패키지의 소스가 바뀌면
    // 이 노드를 거쳐 캐시가 무효화되므로, typecheck·lint는 의존 순서를 기다리지 않고 병렬로 돌면서도
    // 바뀐 인터페이스를 놓치지 않는다
    "transit": {
      "dependsOn": ["^transit"]
    },
    // 커밋하지 않는 생성물(api-client)을 만든다. 스크립트가 없는 패키지는 건너뛴다
    "generate": {
      "outputs": ["src/generated/**"]
    },
    // 생성물을 import하는 검사는 자기 패키지와 의존 패키지의 generate를 기다린다
    "typecheck": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "lint": {
      "dependsOn": ["transit", "generate", "^generate"],
      // 공용 설정은 루트에 있어 패키지 입력에 들어가지 않는다. 바뀌면 모든 패키지를 다시 검사한다
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "test": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
